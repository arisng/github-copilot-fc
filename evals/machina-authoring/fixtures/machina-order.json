{
  "id": "order-fulfillment-complete",
  "name": "Order Fulfillment (Complete)",
  "version": "2.1.0",
  "spec_version": "3.0.0",
  "description": "Full order lifecycle with payment, delivery, returns, and embedded coverage analysis.",
  "initial": "placed",
  "context": {
    "order_id": "ORD-1042",
    "priority": "standard",
    "retry_count": 0,
    "payment_retries": 0,
    "inventory_held": false,
    "refund_eligible": false
  },
  "tools": {
    "payment-gateway-check": {
      "cmd": "py scripts/check_payment.py {ctx.order_id}",
      "expect_exit": 0,
      "timeout_seconds": 30
    },
    "inventory-hold": {
      "cmd": "py scripts/check_inventory.py {ctx.order_id}",
      "expect_exit": 0,
      "timeout_seconds": 30,
      "output": {
        "held": "inventory_held"
      }
    },
    "shipping-label-ready": {
      "cmd": "py scripts/check_label.py {ctx.order_id}",
      "expect_exit": 0,
      "timeout_seconds": 30
    },
    "refund-eligible": {
      "cmd": "py scripts/check_refund.py {ctx.order_id}",
      "expect_exit": 0,
      "timeout_seconds": 30,
      "output": {
        "eligible": "refund_eligible"
      }
    }
  },
  "limits": {
    "max_events": 40,
    "max_steps": 12,
    "timeout_seconds": 1800
  },
  "coverage": {
    "generated": "2026-08-22T10:30:00Z",
    "version": "3.0.0",
    "metrics": {
      "total_states": 11,
      "final_states": 2,
      "total_transitions": 15,
      "unique_paths": 24,
      "theoretical_max_paths": 32,
      "coverage_percentage": 75,
      "complexity_score": 4.2,
      "cyclomatic_complexity": 6
    },
    "state_coverage": {
      "placed": {
        "visited": true,
        "incoming": 1,
        "outgoing": 3
      },
      "payment-failed": {
        "visited": true,
        "incoming": 1,
        "outgoing": 1
      },
      "paid": {
        "visited": true,
        "incoming": 2,
        "outgoing": 1
      },
      "shipped": {
        "visited": true,
        "incoming": 2,
        "outgoing": 3
      },
      "delivery-failed": {
        "visited": true,
        "incoming": 1,
        "outgoing": 1
      },
      "delivered": {
        "visited": true,
        "incoming": 2,
        "outgoing": 1
      },
      "return-requested": {
        "visited": true,
        "incoming": 1,
        "outgoing": 2
      },
      "return-approved": {
        "visited": true,
        "incoming": 1,
        "outgoing": 1
      },
      "return-received": {
        "visited": true,
        "incoming": 1,
        "outgoing": 1
      },
      "cancelled": {
        "visited": true,
        "incoming": 1,
        "outgoing": 1
      },
      "refunded": {
        "visited": true,
        "incoming": 2,
        "outgoing": 0
      }
    },
    "edge_coverage": {
      "PAY": {
        "from": "placed",
        "to": "paid",
        "covered": true
      },
      "PAYMENT_FAILED": {
        "from": "placed",
        "to": "payment-failed",
        "covered": true
      },
      "CANCEL": {
        "from": "placed",
        "to": "cancelled",
        "covered": true
      },
      "RETRY_PAYMENT": {
        "from": "payment-failed",
        "to": "paid",
        "covered": true
      },
      "SHIP": {
        "from": "paid",
        "to": "shipped",
        "covered": true
      },
      "DELIVER": {
        "from": "shipped",
        "to": "delivered",
        "covered": true
      },
      "DELIVERY_FAILED": {
        "from": "shipped",
        "to": "delivery-failed",
        "covered": true
      },
      "RETRY_DELIVERY": {
        "from": "delivery-failed",
        "to": "shipped",
        "covered": true
      },
      "REFUND": {
        "from": "shipped",
        "to": "refunded",
        "covered": true
      },
      "RETURN_REQUEST": {
        "from": "delivered",
        "to": "return-requested",
        "covered": true
      },
      "APPROVE_RETURN": {
        "from": "return-requested",
        "to": "return-approved",
        "covered": true
      },
      "REJECT_RETURN": {
        "from": "return-requested",
        "to": "delivered",
        "covered": false
      },
      "RECEIVE_RETURN": {
        "from": "return-approved",
        "to": "return-received",
        "covered": true
      },
      "ISSUE_REFUND": {
        "from": "return-received",
        "to": "refunded",
        "covered": true
      },
      "REOPEN": {
        "from": "cancelled",
        "to": "placed",
        "covered": false
      }
    },
    "uncovered_paths": [
      "delivered -> return-requested -> delivered (reject-return loop)",
      "cancelled -> placed (reopen cycle)"
    ],
    "recommendations": [
      "Add a transition from 'return-received' to 'placed' for inventory restock",
      "Consider a 'REPLACE' event from 'delivered' for exchanges",
      "Guard RETRY_DELIVERY with a retry_count < 3 limit"
    ]
  },
  "cycle_prevention": {
    "max_retry_limit": 3,
    "timeout_seconds": 300,
    "guards": [
      {
        "event": "RETRY_DELIVERY",
        "guard": {
          "type": "compare",
          "key": "retry_count",
          "op": "lt",
          "value": 3
        },
        "else_target": "refunded"
      },
      {
        "event": "RETRY_PAYMENT",
        "guard": {
          "type": "compare",
          "key": "payment_retries",
          "op": "lt",
          "value": 2
        },
        "else_target": "cancelled"
      }
    ]
  },
  "scenarios": [
    {
      "id": "new-order",
      "label": "New order",
      "initial": "placed",
      "interface": "API",
      "inputs": {
        "order_id": {
          "required": true,
          "type": "string"
        },
        "priority": {
          "required": true,
          "type": "string"
        }
      }
    },
    {
      "id": "payment-failed",
      "label": "Payment failed",
      "initial": "payment-failed",
      "interface": "API",
      "inputs": {
        "order_id": {
          "required": true,
          "type": "string"
        }
      }
    },
    {
      "id": "in-transit",
      "label": "In transit",
      "initial": "shipped",
      "interface": "UI",
      "inputs": {
        "order_id": {
          "required": true,
          "type": "string"
        }
      }
    },
    {
      "id": "return-requested",
      "label": "Return requested",
      "initial": "return-requested",
      "interface": "UI",
      "inputs": {
        "order_id": {
          "required": true,
          "type": "string"
        }
      }
    }
  ],
  "states": {
    "placed": {
      "description": "Order created, awaiting payment.",
      "checks": [
        "payment-gateway-check"
      ],
      "on": {
        "PAY": {
          "target": "paid",
          "description": "Payment processed successfully."
        },
        "PAYMENT_FAILED": {
          "target": "payment-failed",
          "description": "Charge declined by gateway."
        },
        "CANCEL": {
          "target": "cancelled",
          "description": "Customer cancelled the order."
        }
      }
    },
    "payment-failed": {
      "description": "Charge declined.",
      "checks": [
        "payment-gateway-check"
      ],
      "on": {
        "RETRY_PAYMENT": {
          "target": "paid",
          "description": "Retry payment capture after transient failure.",
          "guard": {
            "type": "compare",
            "key": "payment_retries",
            "op": "lt",
            "value": 2
          },
          "actions": [
            {
              "type": "increment",
              "key": "payment_retries"
            }
          ],
          "requires": [
            "payment-gateway-check"
          ],
          "ensures": [
            "inventory-hold"
          ],
          "else_target": "cancelled"
        }
      }
    },
    "paid": {
      "description": "Payment captured.",
      "invariants": [
        "inventory-hold"
      ],
      "on": {
        "SHIP": {
          "target": "shipped",
          "description": "Hand order to the carrier."
        }
      }
    },
    "shipped": {
      "description": "Handed to the carrier.",
      "on": {
        "DELIVER": {
          "target": "delivered",
          "description": "Carrier delivered to customer."
        },
        "DELIVERY_FAILED": {
          "target": "delivery-failed",
          "description": "Carrier could not deliver."
        },
        "REFUND": {
          "target": "refunded",
          "description": "Refund issued before delivery.",
          "requires": [
            "refund-eligible"
          ],
          "ensures": [
            "refund-eligible"
          ]
        }
      }
    },
    "delivery-failed": {
      "description": "Carrier could not deliver.",
      "on": {
        "RETRY_DELIVERY": {
          "target": "shipped",
          "description": "Schedule redelivery attempt.",
          "guard": {
            "type": "compare",
            "key": "retry_count",
            "op": "lt",
            "value": 3
          },
          "actions": [
            {
              "type": "increment",
              "key": "retry_count"
            }
          ],
          "requires": [
            "shipping-label-ready"
          ],
          "ensures": [
            "shipping-label-ready"
          ],
          "else_target": "refunded"
        }
      }
    },
    "delivered": {
      "description": "In the customer's hands.",
      "on": {
        "RETURN_REQUEST": {
          "target": "return-requested",
          "description": "Customer asked to return the item."
        }
      }
    },
    "return-requested": {
      "description": "Customer asked to return.",
      "on": {
        "APPROVE_RETURN": {
          "target": "return-approved",
          "description": "Return accepted by policy."
        },
        "REJECT_RETURN": {
          "target": "delivered",
          "description": "Return rejected; keep the item."
        }
      }
    },
    "return-approved": {
      "description": "Return accepted.",
      "on": {
        "RECEIVE_RETURN": {
          "target": "return-received",
          "description": "Item back at the warehouse."
        }
      }
    },
    "return-received": {
      "description": "Item back at the warehouse.",
      "on": {
        "ISSUE_REFUND": {
          "target": "refunded",
          "description": "Issue refund for returned item.",
          "requires": [
            "refund-eligible"
          ],
          "ensures": [
            "refund-eligible"
          ]
        }
      }
    },
    "cancelled": {
      "type": "final",
      "description": "Terminal - cancelled (may be reopened).",
      "on": {
        "REOPEN": {
          "target": "placed",
          "description": "Reopen a cancelled order."
        }
      }
    },
    "refunded": {
      "type": "final",
      "description": "Terminal - refunded."
    }
  }
}
