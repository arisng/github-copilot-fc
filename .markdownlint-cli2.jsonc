{
  // Markdown lint for the Copilot FC workspace — mechanical rules only.
  // Wired into scripts/workspace/workspace-check.ps1, which scans every .md this
  // config does not ignore against the committed debt baseline (full-tree
  // ratchet: any new file or count increase fails).
  // No "globs" here on purpose: inputs come from the caller so a bare config
  // can never fan out to a whole-repo lint of legacy docs.
  "config": {
    "default": true,
    "MD013": false, // line length — tables, command lines, and wiki prose run long by design
    "MD024": { "siblings_only": true }, // repeated section names across different parents are fine
    "MD033": false, // inline HTML (details/badges) appears in older docs
    "MD036": false, // bold lead-ins are used as pseudo-headings in some lists
    "MD028": false, // consecutive admonition blocks (CRITICAL/IMPORTANT) are intentional
    "MD060": false // table pipe style — legacy tables mix compact/aligned styles everywhere
  },
  "ignores": [
    "**/node_modules/**",
    "**/.archived/**",
    "**/.build/**",
    "**/.playwright-cli/**",
    "workshops/**",
    ".issues/**",
    // Scratch dirs from issue-tree sync sessions (untracked, generated):
    // never lint, never committed as debt.
    ".sync-*/**",
    // Gitignored session handoffs (per-machine, never committed, invisible to
    // CI): local notes must not gate local commits.
    ".agent-handoffs/**",
    // Preserved third-party research essays (moved from .docs as-is) — kept,
    // not ratchet-managed, same rationale as .issues/workshops above.
    "docs/blazor-agui/**",
    "evals/**/fixtures/**",
    "evals/**/results/**"
  ]
}
