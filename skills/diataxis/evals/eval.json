        {
          "id": "A2",
          "type": "coverage",
          "description": "contains Tutorials",
          "passes_when": "contains(\"Tutorials\")"
        },
        {
          "id": "A3",
          "type": "structural",
          "description": "has sections",
          "passes_when": "heading_count >= 5"
        }
      ]
    },
    {
      "id": "case-02",
      "prompt": "nearby prompt",
      "expected_trigger": false,
